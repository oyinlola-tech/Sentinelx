# SentinelX configuration. Copy to .env and edit; never commit .env.
#
# Every setting also has a nested form, e.g. DETECTION__PORT_SCAN_UNIQUE_PORTS=30.
# The environment beats .env; the nested form beats the short form.
# Full reference: docs/deployment.md#configuration
#
# Keep comments on their own lines: some trailing comments are read as part of the value.

# ----------------------------------------------------------------- general
# development | staging | production
# Leave unset for local development. docker compose defaults to production, which
# enforces a strong JWT_SECRET, secure cookies, PostgreSQL and no API docs.
# ENVIRONMENT=production
SENSOR_NAME=sentinelx-local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# ---------------------------------------------------------------- storage
# SQLite needs no setup and is fine for evaluation. Use PostgreSQL in production:
# DATABASE_URL=postgresql://sentinelx:CHANGE_ME@127.0.0.1:5432/sentinelx
DATABASE_URL=sqlite+aiosqlite:///./sentinelx.db
# Optional. Without Redis, rate limits and WebSocket tickets are per process.
REDIS_URL=redis://127.0.0.1:6379/0
RETENTION_DAYS=30

# -------------------------------------------------------------------- API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Required in production (docker compose): at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Password for the first admin account. Leave empty to have one generated and
# printed once in the server console (you must change it at first sign-in).
API__BOOTSTRAP_ADMIN_PASSWORD=
# Bearer token for /api/v1/metrics from Prometheus on another host. Without it,
# metrics are served only to scrapers on this host.
API__METRICS_TOKEN=
# Reverse proxies whose X-Forwarded-For is believed, as a JSON list of CIDRs.
# API__TRUSTED_PROXIES=["127.0.0.1/32"]

# ---------------------------------------------------------------- capture
# An interface name, or "any". See: sentinelx interfaces
CAPTURE_INTERFACE=any
# auto | af_packet | libpcap
CAPTURE__BACKEND=auto
BPF_FILTER=
PCAP_DIRECTORY=./pcaps

# ------------------------------------------------------ detection/response
# disabled | signature_only | balanced | aggressive
DETECTION_MODE=balanced
# Safety defaults: observe and explain, never touch traffic.
# detect_only | manual_approval | automatic
RESPONSE_MODE=detect_only
DRY_RUN=true
# null | auto | nftables | iptables | pf | windows_firewall
# See: sentinelx capabilities
FIREWALL_BACKEND=null

# -------------------------------------------------------- docker compose only
POSTGRES_USER=sentinelx
POSTGRES_DB=sentinelx
# Required for docker compose.
POSTGRES_PASSWORD=
# Required for docker compose.
REDIS_PASSWORD=
# Host port for the dashboard, API and event stream (all served by the proxy).
DASHBOARD_PORT=3000
# Capture profile: the sensor's port on the host, and the proxy's upstream to match.
# SENSOR_PORT=8001
# API upstream for the proxy. Capture profile: ${FRONTEND_GATEWAY}:${SENSOR_PORT}, e.g. 172.31.250.1:8001
# SENTINELX_API_UPSTREAM=api:8000
# Subnet of the compose frontend network (change only if it clashes with yours).
# FRONTEND_SUBNET=172.31.250.0/24
# Gateway of that network: the capture profile's sensor listens only on this address.
# FRONTEND_GATEWAY=172.31.250.1
