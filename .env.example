# SentinelX configuration. Copy to .env and edit; never commit .env.
# Every setting also has a nested form, e.g. DETECTION__PORT_SCAN_UNIQUE_PORTS=30.
# Full reference: docs/deployment.md#configuration

# ----------------------------------------------------------------- general
ENVIRONMENT=development          # development | staging | production
SENSOR_NAME=sentinelx-local
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console | json

# ---------------------------------------------------------------- storage
# SQLite needs no setup and is fine for evaluation. Use PostgreSQL in production:
# DATABASE_URL=postgresql://sentinelx:CHANGE_ME@127.0.0.1:5432/sentinelx
DATABASE_URL=sqlite+aiosqlite:///./sentinelx.db
REDIS_URL=redis://127.0.0.1:6379/0
RETENTION_DAYS=30

# -------------------------------------------------------------------- API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# REQUIRED in production: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Password for the first admin account. Leave empty to have one generated and
# printed once in the server console (you must change it at first sign-in).
API__BOOTSTRAP_ADMIN_PASSWORD=
# Bearer token for /api/v1/metrics from non-loopback Prometheus scrapers.
API__METRICS_TOKEN=

# ---------------------------------------------------------------- capture
CAPTURE_INTERFACE=any
BPF_FILTER=
PCAP_DIRECTORY=./pcaps

# ------------------------------------------------------ detection/response
DETECTION_MODE=balanced          # disabled | signature_only | balanced | aggressive
# Safety defaults: observe and explain, never touch traffic.
RESPONSE_MODE=detect_only        # detect_only | manual_approval | automatic
DRY_RUN=true
FIREWALL_BACKEND=null            # null | nftables | iptables

# -------------------------------------------------- docker compose only
POSTGRES_USER=sentinelx
POSTGRES_DB=sentinelx
POSTGRES_PASSWORD=               # REQUIRED for docker compose
REDIS_PASSWORD=                  # REQUIRED for docker compose
ADMIN_PASSWORD=                  # optional; see API__BOOTSTRAP_ADMIN_PASSWORD
DASHBOARD_PORT=3000
