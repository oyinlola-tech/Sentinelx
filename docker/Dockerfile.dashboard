# syntax=docker/dockerfile:1.7
# SentinelX dashboard (Next.js standalone server).

FROM node:24-alpine AS deps
WORKDIR /app
COPY apps/dashboard/package.json apps/dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:24-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY apps/dashboard ./
RUN npm run build

FROM node:24-alpine AS runtime
LABEL org.opencontainers.image.title="sentinelx-dashboard" org.opencontainers.image.licenses="Apache-2.0"
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
RUN addgroup -S -g 10001 sentinelx && adduser -S -u 10001 -G sentinelx sentinelx
COPY --from=build --chown=sentinelx:sentinelx /app/.next/standalone ./
COPY --from=build --chown=sentinelx:sentinelx /app/.next/static ./.next/static
COPY --from=build --chown=sentinelx:sentinelx /app/public ./public
USER sentinelx
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/login >/dev/null || exit 1
CMD ["node", "server.js"]
